# Environment Configuration
NODE_ENV=development
PORT=4000

# Database - Replace with your MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/amdako_strategies
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/amdako_strategies
MONGO_URI=mongodb://localhost:27017/amdako_strategies

# JWT - CHANGE THIS IN PRODUCTION!
JWT_SECRET=
JWT_EXPIRE=30d

# CORS
FRONTEND_URL=http://localhost:5173