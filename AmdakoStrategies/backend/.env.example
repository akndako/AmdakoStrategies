# Server Configuration
PORT=3000
NODE_ENV=production

# MongoDB Atlas (Cloud Database)
# Sign up at https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/amdako

# JWT Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-here-change-this

# Domain Configuration (IMPORTANT: Update for amdakostrategies.com.ng)
FRONTEND_URL=https://amdakostrategies.com.ng
VITE_API_URL=https://amdakostrategies.com.ng/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
